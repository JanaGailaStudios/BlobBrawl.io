{
  "name": "blobbrawl-io",
  "version": "1.0.0",
  "private": true,
  "description": "BlobBrawl.io - real-time multiplayer blob arena brawler",
  "main": "server/index.js",
  "scripts": {
    "start": "node server/index.js",
    "dev": "node --watch server/index.js",
    "test": "node test/smoke.js",
    "test:client": "node test/client.js",
    "test:all": "node test/smoke.js && node test/client.js && node test/e2e.js",
    "test:e2e": "node test/e2e.js"
  },
  "engines": {
    "node": ">=22.13.0"
  },
  "keywords": [
    "io-game",
    "multiplayer",
    "socket.io",
    "game"
  ],
  "license": "MIT",
  "dependencies": {
    "express": "^4.21.2",
    "socket.io": "^4.8.1"
  },
  "devDependencies": {
    "esbuild": "^0.28.2",
    "jsdom": "^30.1.3",
    "socket.io-client": "^4.8.4"
  }
}
