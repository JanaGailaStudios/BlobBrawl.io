# ---------------------------------------------------------------------------
# BlobBrawl.io server configuration
# Copy this file to `.env` (or export the variables) before running in prod.
# ---------------------------------------------------------------------------

# HTTP + WebSocket port. Most hosts inject PORT automatically.
PORT=3000

# Interface to bind. 0.0.0.0 exposes the server to your network / host proxy.
HOST=0.0.0.0

# development | production
NODE_ENV=development

# Long random string used to derive opaque account tokens.
# Generate one with:  node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
SECRET=change-me-to-a-long-random-string

# SQLite database file (created automatically, WAL mode).
DB_PATH=./data/blobbrawl.db

# Realtime tuning
MAX_ROOMS=4              # how many arenas may exist at once
ROOM_CAPACITY=40         # human players per arena before matchmaking opens a new one
MIN_BOTS=5               # bots added while the arena is quiet
MAX_BOTS=12              # bot ceiling per arena

# Set to 1 when running behind a reverse proxy (Render, Fly, nginx, Cloudflare)
# so rate limiting sees real client IPs.
TRUST_PROXY=1

# Comma separated list of allowed browser origins. Leave empty for same-origin.
# CORS_ORIGIN=https://blobbrawl.example.com

# Verbose per-life server logging (kills, orbs, rank). Useful for anti-cheat audits.
LOG_GAMEPLAY=0
